graph LR
    WAV["TIMIT .WAV<br>16 kHz NIST SPHERE<br>3696 train / 192 core test"]
    TXT["TIMIT .TXT<br>orthographic"]
    PHN["TIMIT .PHN<br>61 phones"]
    FOLD["fold 61 to 39<br>Lee and Hon 1989"]

    CONV["conv feature encoder<br>7 layers, 4.2M<br>pretrained, FROZEN"]
    TRF["12 transformer layers<br>89.8M, pretrained<br>FINE-TUNED, 768-dim"]
    DROP["dropout"]

    H1["FRESH linear head<br>Linear 768 to 30<br>23,070 params<br>random init"]
    H2["FRESH linear head<br>Linear 768 to 41<br>31,529 params<br>random init"]

    WER["step 1: WER"]
    PER["step 2: PER"]

    WAV --> CONV
    CONV --> TRF
    TRF --> DROP
    DROP --> H1
    DROP --> H2
    H1 --> WER
    H2 --> PER
    TXT -. "CTC target" .-> H1
    PHN --> FOLD
    FOLD -. "CTC target" .-> H2

    classDef frozen fill:#e8eef8,stroke:#4a6fa5,stroke-width:2px
    classDef tuned fill:#e9f5ec,stroke:#4aa06a,stroke-width:2px
    classDef fresh fill:#fdece8,stroke:#e8674a,stroke-width:3px,stroke-dasharray:6 3
    classDef data fill:#f4f4f4,stroke:#999999
    class CONV frozen
    class TRF tuned
    class H1,H2 fresh
    class WAV,TXT,PHN,FOLD,WER,PER,DROP data
